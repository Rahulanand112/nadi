# Neon pooled connection string. Use the POOLED one (it contains -pooler in the
# host) -- serverless functions open many short-lived connections and will
# exhaust a direct connection limit.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection. Prisma Migrate needs this for schema changes.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth. BETTER_AUTH_URL is where the app is running (localhost in dev,
# your real domain once deployed). BETTER_AUTH_SECRET signs session tokens --
# generate one with: openssl rand -base64 32 (or any random 32+ char string).
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-random-32-character-string"
