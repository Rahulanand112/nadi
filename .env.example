# Neon pooled connection string. Use the POOLED one (it contains -pooler in the
# host) -- serverless functions open many short-lived connections and will
# exhaust a direct connection limit.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection. Prisma Migrate needs this for schema changes.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth. BETTER_AUTH_URL is where the app is running (localhost in dev,
# your real domain once deployed). BETTER_AUTH_SECRET signs session tokens --
# generate one with: openssl rand -base64 32 (or any random 32+ char string).
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-random-32-character-string"

# Inngest, for the background reminder sweep. Optional in development (the
# Inngest dev server runs without keys); required in production -- see the
# superRefine block in src/lib/env.ts.
INNGEST_EVENT_KEY="replace-with-your-inngest-event-key"
INNGEST_SIGNING_KEY="replace-with-your-inngest-signing-key"

# VAPID keypair for web push. Optional in development; required in
# production per the superRefine block in src/lib/env.ts -- the app refuses
# to start without them once NODE_ENV=production. Generate a keypair with:
#   npx web-push generate-vapid-keys
# The public half is NEXT_PUBLIC_ on purpose (the browser needs it to create
# a subscription); never expose the private half to the client.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-with-your-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-your-vapid-private-key"
VAPID_SUBJECT="mailto:your-email@example.com"
