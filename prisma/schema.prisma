// Nadi's data model.
//
// Grown one version at a time rather than designed up front. Section comments
// record which slice introduced what, and more importantly why a shape was
// chosen, so a decision can be revisited later on its merits rather than
// guessed at.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model HealthCheck {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())

  @@map("health_checks")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// IANA zone name ("Asia/Kolkata"), captured from the browser on sign-in.
  ///
  /// Needed because habit reminders are wall-clock times: "remind me at 7am"
  /// means 7am where the person is, and nothing else in the system knows
  /// where that is. Vercel runs on UTC and the database is in Singapore, so
  /// without this a 7am reminder would fire at whatever 7am means to a server
  /// the person has never thought about.
  ///
  /// Defaults to UTC rather than being nullable: every existing row needs a
  /// value at migration time, and a wrong-but-known zone is easier to reason
  /// about than a null that every caller must handle.
  timezone      String    @default("UTC")

  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  pushSubscriptions PushSubscription[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Slice 2 domain models.
//
// Everything above this line came from Better Auth and answers "who is this
// person, and are they signed in". Everything below is Nadi's own domain:
// households and teams (Workspace), who belongs to them and in what capacity
// (Membership), and pending invitations.
//
// Deliberately NOT using Better Auth's "organization" plugin -- see
// docs/decisions.md (ADR 005) for why these stay separate from auth.
// ---------------------------------------------------------------------------

enum MembershipRole {
  OWNER
  MEMBER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invitations Invitation[]
  tasks       Task[]
  habits      Habit[]
  reminders   Reminder[]

  @@map("workspaces")
}

/// The join between a person and a household/team. A user can hold a
/// Membership in more than one Workspace (e.g. "Family" and "Office"), each
/// with its own role and its own display name -- someone might be "Dad" in
/// one and "R. Sharma" in the other.
model Membership {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String
  role        MembershipRole @default(MEMBER)
  displayName String
  createdAt   DateTime       @default(now())

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks Task[]    @relation("AssignedTasks")
  createdTasks  Task[]    @relation("CreatedTasks")
  habits        Habit[]
  reminders     Reminder[]
  comments      TaskComment[]

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

/// A pending invite to join a Workspace, sent to an email address that may
/// not yet have a Nadi account. Consumed (and deleted) once accepted.
model Invitation {
  id          String         @id @default(cuid())
  workspaceId String
  email       String
  role        MembershipRole @default(MEMBER)
  token       String         @unique
  invitedBy   String
  expiresAt   DateTime
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // One pending invitation per email per workspace. Re-inviting the same
  // person replaces the old invite rather than accumulating duplicates.
  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Slice 4 — tasks.
//
// Note what is NOT stored here: status. Green/amber/red is derived from
// completedAt and dueAt at read time (see src/lib/task-status.ts). Storing it
// as a column would mean every task in the database silently becomes wrong the
// moment its due time passes, and would need a background job to correct.
// ---------------------------------------------------------------------------

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String       @id @default(cuid())
  workspaceId String
  title       String
  description String?
  category    String?
  priority    TaskPriority @default(MEDIUM)

  /// Null means "no deadline" — such a task is never overdue.
  dueAt       DateTime?
  /// True when only the date matters, not the time of day.
  isAllDay    Boolean      @default(false)

  /// Null until someone ticks the checkbox. Doubles as the completion
  /// timestamp, which Slice 5's analytics need anyway.
  completedAt DateTime?

  /// Tasks are assigned to a Membership, not a User: the same person in two
  /// workspaces holds two memberships, and a task belongs to one of them.
  assigneeId  String?
  createdById String

  /// Null means this task happens once. When set, completing the task creates
  /// the next occurrence rather than ending the series.
  recurrence         RecurrenceFrequency?
  /// Every occurrence of the same repeating task shares this id, so a series
  /// can be counted or cancelled as a unit later.
  seriesId           String?

  // v0.3 — reminders.
  //
  // Only two columns, because a task already carries its own moment: dueAt is
  // a real instant, so the reminder time is dueAt minus the offset and needs
  // no separate column. Storing a computed fireAt would repeat the mistake
  // this schema avoids with task status — it would go stale the moment
  // somebody reschedules the task.
  reminderEnabled       Boolean @default(false)
  /// Minutes before dueAt. See REMINDER_OFFSETS in src/lib/reminder.ts.
  reminderOffsetMinutes Int     @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  Membership? @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy Membership  @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
  reminder  Reminder?
  comments  TaskComment[]

  @@index([workspaceId, dueAt])
  @@index([assigneeId])
  @@index([seriesId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// v0.2 — recurrence and habits.
//
// Recurrence lives on the Task itself rather than in a separate "template"
// table. Completing a recurring task spawns the next occurrence at that
// moment, so the database holds one row per real thing to do instead of
// hundreds of pre-generated future rows that may never happen.
// ---------------------------------------------------------------------------

enum RecurrenceFrequency {
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
}

/// A habit is a thing you want to do repeatedly, where consistency is the
/// point rather than completion. Deliberately NOT modelled as a recurring
/// task: a missed task is a failure to be rescheduled, while a missed day of a
/// habit is just a gap in a chain. Merging them would force one set of
/// semantics onto both.
model Habit {
  id           String  @id @default(cuid())
  workspaceId  String
  membershipId String
  name         String
  /// A single emoji shown beside the habit. Cheap personality, no upload.
  icon         String?
  /// How many days a week the person is aiming for. Used by the weekly
  /// consistency figure, not enforced.
  targetPerWeek Int    @default(7)
  archivedAt   DateTime?

  // v0.3 — reminders.
  //
  // A habit needs an extra column that a task does not, because a habit has no
  // instant of its own. "Morning run" happens at 7am, and 7am is a wall-clock
  // reading rather than a point in time until it is paired with the owner's
  // timezone (User.timezone). Storing minutes-from-midnight rather than a
  // DateTime keeps that distinction visible in the schema: this is a time of
  // day, not a moment, and it must never be read as one.
  //
  /// Minutes from local midnight — 420 is 07:00. Null means no time set,
  /// which also means no reminder is possible.
  remindAtMinutes       Int?
  reminderEnabled       Boolean @default(false)
  /// Minutes before remindAtMinutes. Same option list as tasks.
  reminderOffsetMinutes Int     @default(30)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membership  Membership        @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]
  reminders   Reminder[]

  @@index([workspaceId])
  @@index([membershipId])
  @@map("habits")
}

/// One row per habit per day it was done. `day` is a plain date, not a
/// timestamp: "did you do it on the 5th" has no time component, and storing a
/// timestamp would make timezone bugs inevitable when computing streaks.
model HabitCompletion {
  id        String   @id @default(cuid())
  habitId   String
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, day])
  @@index([habitId, day])
  @@map("habit_completions")
}

// ---------------------------------------------------------------------------
// v0.3 — reminders.
//
// A Reminder is a notification that has already fired. It is not a schedule:
// nothing here says when a future reminder should happen, because that is
// derivable from the task or habit it belongs to. A background sweep runs
// every few minutes, works out which reminders have come due since it last
// looked, and writes rows here.
//
// Why a sweep rather than scheduling a delayed job per reminder at the moment
// somebody ticks the toggle: tasks get rescheduled, completed, deleted, and
// respawned by recurrence. Each of those would leave an in-flight job pointing
// at a task that has moved, so every one of those paths would need matching
// cancel-and-reschedule logic, and any path that forgot would fire a reminder
// for a deadline that no longer exists. A sweep reads current state each time
// and cannot go stale. The cost is precision — a reminder can land a few
// minutes late — which for a household task list is not a real cost.
//
// Reminders point at a Membership rather than a User because that is how the
// rest of the domain addresses people, and because the workspace boundary has
// to hold here too: a reminder must never surface in the wrong household.
// ---------------------------------------------------------------------------

model Reminder {
  id           String    @id @default(cuid())
  workspaceId  String
  membershipId String

  /// Exactly one of these is set. Kept as two nullable columns rather than a
  /// polymorphic id + type pair so the foreign keys stay real and deleting a
  /// task takes its reminder with it.
  taskId       String?
  habitId      String?

  /// The local day a habit reminder belongs to. Null for tasks, which are
  /// one-off and identified by taskId alone. This is what makes "one reminder
  /// per habit per day" expressible as a constraint instead of a query.
  day          DateTime? @db.Date

  /// Copied at write time rather than joined at read time. A reminder is a
  /// record of something that was true at a moment; if the task is later
  /// renamed or deleted, the notification the person received should not
  /// silently change wording or vanish.
  title        String
  body         String?

  /// When this was due — not when the row was written. The sweep runs on a
  /// cadence, so createdAt is a few minutes later and is the wrong thing to
  /// show or sort by.
  fireAt       DateTime
  /// Null until the person has seen it.
  readAt       DateTime?

  /// Null until a push notification has been sent for this reminder.
  ///
  /// Kept separate from the row's existence because creating the reminder and
  /// delivering it are different failures with different fixes: a reminder
  /// that exists but was never pushed should be retried, while one that was
  /// pushed must never be pushed twice. Folding both into one row with no
  /// delivery marker would mean either dropping pushes on a transient network
  /// error or re-notifying somebody every five minutes forever.
  pushedAt     DateTime?

  createdAt    DateTime  @default(now())

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  task       Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  habit      Habit?     @relation(fields: [habitId], references: [id], onDelete: Cascade)

  // The database, not the sweep, guarantees no duplicates. Two overlapping
  // runs would otherwise both see the same due reminder and write it twice;
  // Postgres allows many nulls in a unique index, so these two constraints
  // coexist without either blocking the other's kind of row.
  @@unique([taskId])
  @@unique([habitId, day])
  @@index([membershipId, readAt])
  @@index([fireAt])
  // Drives the delivery sweep, which asks for unpushed reminders only.
  @@index([pushedAt])
  @@map("reminders")
}

// ---------------------------------------------------------------------------
// v0.3 — web push.
//
// A PushSubscription is one browser on one device that has agreed to receive
// notifications. Attached to a User rather than a Membership because a phone
// belongs to a person, not to a household: somebody in both "Family" and
// "Office" carries one phone and should not have to grant permission twice,
// nor receive two copies of everything.
//
// The three fields the browser hands us (endpoint, p256dh, auth) are not ours
// to interpret. The endpoint is a URL at the browser vendor's own push service
// — Apple's for Safari, Google's for Chrome — and the two keys encrypt the
// payload so that service can route a message it cannot read. Nadi stores them
// verbatim and passes them back.
// ---------------------------------------------------------------------------

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String

  /// The vendor push service URL. Unique because it *is* the device's
  /// identity: re-subscribing on the same browser returns the same endpoint,
  /// so upserting on it keeps one row per device rather than accumulating a
  /// new one on every visit.
  endpoint  String   @unique
  /// Public key and auth secret from the browser, used to encrypt payloads.
  p256dh    String
  auth      String

  /// Recorded only to make a device list legible to a human later ("iPhone
  /// Safari" vs "Windows Chrome"); never parsed for behaviour.
  userAgent String?

  createdAt  DateTime  @default(now())
  /// Bumped on each successful send, so a device that has gone quiet is
  /// visible rather than merely absent.
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// v0.3 — comments on tasks.
//
// The point of a shared task list is coordination, and coordination is mostly
// conversation: "I'll do this after work", "we're out of the stuff for this",
// "already done, forgot to tick it". Without somewhere to put that, it happens
// in a separate chat app and the task and the discussion about it live in
// different places.
//
// Flat, not threaded. A household task rarely sustains a sub-argument, and
// threading costs a parentId, recursive queries, and a rendering problem in
// exchange for a structure nobody would use here.
//
// Authored by a Membership rather than a User, matching every other authored
// thing in the schema. It also means a comment carries the display name the
// person uses in *that* workspace — "Dad" at home, "R. Sharma" at work —
// rather than leaking one context's name into the other.
// ---------------------------------------------------------------------------

model TaskComment {
  id           String   @id @default(cuid())
  taskId       String
  membershipId String
  body         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  // Comments are always read as "all comments on this task, oldest first",
  // so the index matches that access pattern rather than indexing taskId
  // alone and sorting in memory.
  @@index([taskId, createdAt])
  @@map("task_comments")
}
